# ==============================================================================
# CONFIGURACIÓN DE CÁRCELES (JAILS) - FAIL2BAN
# ==============================================================================
# Añadir este contenido al archivo /etc/fail2ban/jail.local
# ==============================================================================

[sshd]
enabled = true
port = ssh
maxretry = 5
bantime = 1h

[jellyfin]
enabled = true
port = 80,443,8096
filter = jellyfin
# Ajusta la ruta a la ubicación de tus logs de Jellyfin
logpath = /ruta/a/tu/jellyfin/config/log/log_*.log
maxretry = 3
findtime = 1d
bantime = 1h
